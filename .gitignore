# All intermediate artifacts live under build/; bin/ holds only the staged,
# distributable libraries (bin/linux/<profile>/, bin/x4/).
/build/
/bin/
/.pio/
compile_commands.json
*.pbm

# Third-party packages (FreeInk, littlefs, FatFs, PlatformIO platforms,
# toolchains and libraries), downloaded by make; only `make purge` removes them.
/packages/
